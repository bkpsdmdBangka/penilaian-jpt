rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────

    // Cek apakah caller adalah admin (Email terdaftar di koleksi admins)
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // ─── admins/{email} ─────────────────────────────────────────
    match /admins/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow write: if false; // Hanya diubah dari Firebase Console langsung
    }

    // ─── penilai/{token} ────────────────────────────────────────
    // Publik boleh baca 1 dokumen jika ID-nya = token
    match /penilai/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      
      // Penilai boleh update field 'sudahMenilai' saja (client-side bypass)
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sudahMenilai'])
      );
    }

    // ─── penilaian/{id} ─────────────────────────────────────────
    // Client submit form penilaian langsung kesini
    match /penilaian/{id} {
      allow read, update, delete: if isAdmin();
      // Mengizinkan penilai membuat dokumen penilaian baru asalkan formatnya benar
      allow create: if request.resource.data.keys().hasAll(['token', 'kandidatId', 'jumlah', 'nilai20persen', 'createdAt']);
    }

    // ─── kandidat/{id} ──────────────────────────────────────────
    match /kandidat/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Default ──────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
